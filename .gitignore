# secrets
.env

# python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# runtime data (keep the folders, not the contents)
data/captures/*
data/logs/*
data/episodes/*
data/memory/*
data/calibration/*
data/archive/*
data/models/*
data/student/*
data/judge/*
!data/**/.gitkeep

.DS_Store

# native builds (scripts/build_pyrealsense_mac.sh)
third_party/

# vendored Dobot SDK clone (reference only, has its own git):
#   git clone https://github.com/Dobot-Arm/TCP-IP-Python-V3.git external/TCP-IP-Python-V3
external/

# reports stay local (history of the PDF report: local branch `report-local`)
REPORT.md
docs/

# raw phone videos (only the compressed, captioned MP4 in result/ is published)
*.MOV
*.mov

# docs and notes stay local (operator, 21 Nov): README, DISCUSSION, module notes
*.md

# Astra's own routines/checks and their history: written by the agent at run time (like data/memory)
src/agent/astra_skills/*
!src/agent/astra_skills/.gitkeep
